{
  "name": "keel",
  "version": "0.1.0",
  "description": "The shared layer under Aidin's desktop suite: icon pipeline, window chrome, storage, release.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./icon": {
      "types": "./types/icon/index.d.mts",
      "default": "./src/icon/index.mjs"
    },
    "./window": {
      "types": "./types/window/index.d.mts",
      "default": "./src/window/index.mjs"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks",
    "types": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
